1 VERSIONINFO
FILEVERSION @ARACHNEL_VER_MAJOR@,@ARACHNEL_VER_MINOR@,@ARACHNEL_VER_PATCH@,@ARACHNEL_VER_BUILD@
PRODUCTVERSION @ARACHNEL_VER_MAJOR@,@ARACHNEL_VER_MINOR@,@ARACHNEL_VER_PATCH@,@ARACHNEL_VER_BUILD@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Arachnel"
            VALUE "FileDescription", "@ARACHNEL_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@ARACHNEL_VERSION_STR@"
            VALUE "InternalName", "@ARACHNEL_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) Arachnel contributors"
            VALUE "OriginalFilename", "@ARACHNEL_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Arachnel"
            VALUE "ProductVersion", "@ARACHNEL_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
